{
  "name": "fuzzy-files",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Quickly find and take an action over project files.",
  "keywords": [
    "finder",
    "quick-open",
    "search",
    "navigation",
    "project"
  ],
  "repository": "https://github.com/lumine-code/fuzzy-files",
  "bugs": {
    "url": "https://github.com/lumine-code/fuzzy-files/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can open any file in the project by typing part of its name with {{ 'fuzzy-files:toggle' | keystroke }}",
    "You can send the file you picked in the finder straight into a split pane with {{ 'fuzzy-files:split-right' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "atom-workspace": [
      "fuzzy-files:toggle",
      "fuzzy-files:refresh",
      "fuzzy-files:clear-recent"
    ]
  },
  "configSchema": {
    "recentCount": {
      "title": "Number of Recent Files",
      "description": "How many recently opened files to keep at the top of the list.",
      "type": "integer",
      "minimum": 0,
      "default": 10
    },
    "ignoredNames": {
      "title": "List of ignore glob patterns",
      "description": "Files and directories matching these patterns are ignored. This list is merged with the list defined by the core `Ignored Names' configuration setting.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "separator": {
      "title": "Type of separator in file paths",
      "description": "Type of separator for the file path when copying or pasting.",
      "type": "integer",
      "enum": [
        {
          "value": 0,
          "description": "Default"
        },
        {
          "value": 1,
          "description": "Forward Slash"
        },
        {
          "value": 2,
          "description": "Backslash"
        }
      ],
      "default": 0
    }
  },
  "providedServices": {
    "fuzzy-files.score-modifier": {
      "versions": {
        "1.0.0": "provideFuzzyFilesScoreModifier"
      }
    }
  },
  "consumedServices": {
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    },
    "windows-clip": {
      "versions": {
        "^1.0.0": "consumeWindowsClip"
      }
    },
    "claude-chat": {
      "versions": {
        "^1.0.0": "consumeClaudeChat"
      }
    },
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    }
  },
  "dependencies": {
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "github:lumine-code/node-temp#5d0a30ffb4d68f21577d057aef8844a55479e304",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
